# Copy to .env.server on EC2 (never commit the real file).
# Used by app.py (JWT) and Model/netwirk_DB.py (database).

JWT_SECRET_KEY=YOUR_JWT_SECRET

DB_HOST=your-rds-host.amazonaws.com
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
NETWORK_DB_NAME=icebreaker

# Auth service DB (optional). If unset, auth uses DB_* / NETWORK_DB_NAME above.
# Set these after you create vyb_auth and copy registration / otp tables.
# AUTH_DB_HOST=your-rds-host.amazonaws.com
# AUTH_DB_PORT=3306
# AUTH_DB_USER=auth_app
# AUTH_DB_PASSWORD=your_auth_db_password
# AUTH_DB_NAME=vyb_auth
# Docker Compose hostnames. Local app.py ignores these and calls in-process.
# AUTH_SERVICE_URL=http://auth:8000
# INTERNAL_API_KEY=

# Profile service DB (optional). If unset, profile uses DB_* / NETWORK_DB_NAME.
# PROFILE_DB_HOST=your-rds-host.amazonaws.com
# PROFILE_DB_PORT=3306
# PROFILE_DB_USER=profile_app
# PROFILE_DB_PASSWORD=your_profile_db_password
# PROFILE_DB_NAME=vyb_profile
# PROFILE_SERVICE_URL=http://profile:8000

# Social service DB (optional). If unset, social uses DB_* / NETWORK_DB_NAME.
# SOCIAL_DB_HOST=your-rds-host.amazonaws.com
# SOCIAL_DB_PORT=3306
# SOCIAL_DB_USER=social_app
# SOCIAL_DB_PASSWORD=your_social_db_password
# SOCIAL_DB_NAME=vyb_social
# SOCIAL_SERVICE_URL=http://social:8000
# GEO_SERVICE_URL=http://geo:8000

# Optional: override default config file paths
# VIBR_REGISTRATION_CONFIG_FILE=/path/to/vibr_registration_config.json
# VIBR_CONFIG_FILE=/path/to/vibr_config.json
# FIREBASE_SERVICE_ACCOUNT_FILE=/path/to/firebase-admin.json
# VYB_RUNTIME_SECRET_DIR=/var/run/secrets/vyb

# Offline feed cache (reduces Amazon Personalize calls).
# In-memory per process until REDIS_URL is set after launch.
OFFLINE_FEED_CACHE_ENABLED=true
OFFLINE_FEED_CACHE_TTL=600
# OFFLINE_FEED_CACHE_PREFIX=vyb:offline_feed:
# REDIS_URL=redis://localhost:6379/0
